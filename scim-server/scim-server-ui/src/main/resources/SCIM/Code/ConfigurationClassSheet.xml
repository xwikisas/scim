#set ($discard = $xwiki.ssx.use('SCIM.Code.ConfigurationClassSheet'))
#macro (displayField $name)
  #set ($property = $class.get($name))
  #if ($action == 'edit' &amp;&amp; "$!property.getProperty('displayFormType').getValue()" == "checkbox")
    &lt;div&gt;
      &lt;label for="${class.name}_0_${name}"&gt;{{/html}}$confDoc.display($name, $action){{html clean="false"}} $property.prettyName&lt;/label&gt;
      &lt;p class="xHint"&gt;$property.hint&lt;/p&gt;
    &lt;/div&gt;
  #else
    &lt;dt&gt;
      &lt;label for="${class.name}_0_${name}"&gt;$property.prettyName&lt;/label&gt;
      &lt;p class="xHint"&gt;$property.hint&lt;/p&gt;
    &lt;/dt&gt;
    &lt;dd&gt;
      {{/html}}$confDoc.display($name, $action){{html clean="false"}}
    &lt;/dd&gt;
  #end
  #set ($discard = $handledFields.add($name))
#end
#set ($handledFields = [])
#if ($scimConfigurationDoc == $NULL)
  #set ($confDoc = $doc)
  #set ($action = $xcontext.action)
#else
  #set ($confDoc = $scimConfigurationDoc)
  #set ($action = 'edit')
#end
#set ($class = $confDoc.getObject('SCIM.Code.ConfigurationClass').xWikiClass)
{{html clean="false"}}
&lt;div class="xform"&gt;
    &lt;fieldset id="scim-fieldset-config-general"&gt;
      &lt;legend&gt;General&lt;/legend&gt;
      &lt;dl&gt;
        #displayField('users')
        #displayField('advertisedAuthSchemes')
      &lt;/dl&gt;
    &lt;/fieldset&gt;
    &lt;fieldset id="scim-fieldset-config-userformatting"&gt;
      &lt;legend&gt;User and Group Formatting&lt;/legend&gt;
      &lt;dl&gt;
        #displayField('userNameFormat')
        #displayField('groupNameFormat')
        #displayField('usernameCleaningEnabled')
        #displayField('forbiddenPattern')
        #displayField('forbiddenReplacement')
      &lt;/dl&gt;
    &lt;/fieldset&gt;
    &lt;fieldset id="scim-fieldset-config-oidc"&gt;
      &lt;legend&gt;OIDC&lt;/legend&gt;
      #displayField('oidcEnabled')
      &lt;dl id="scim-settings-oidc"&gt;
        #displayField('oidcIssuer')
        #displayField('oidcSubject')
      &lt;/dl&gt;
    &lt;/fieldset&gt;

#set ($miscStarted = false)
#foreach($name in $class.getEnabledPropertyNames())
  #if (!$handledFields.contains($name))
    #if (!$miscStarted)
      &lt;fieldset id="scim-fieldset-config-other"&gt;
        &lt;legend&gt;Miscellaneous&lt;/legend&gt;
        &lt;dl&gt;
      #set ($miscStarted = true)
    #end
    #displayField($name)
  #end
#end
#if ($miscStarted)
    &lt;/dl&gt;
  &lt;/fieldset&gt;
#end
&lt;/div&gt;
{{/html}}
{{/velocity}}</content>
